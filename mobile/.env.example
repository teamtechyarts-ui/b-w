# Development defaults. Copy to .env and adjust for your simulator/device.
BW_DEV_IOS_API_URL=http://127.0.0.1:3000/v1
BW_DEV_IOS_STORAGE_ORIGIN=http://127.0.0.1:54321
BW_DEV_ANDROID_API_URL=http://10.0.2.2:3000/v1
BW_DEV_ANDROID_STORAGE_ORIGIN=http://10.0.2.2:54321
BW_DEV_WEB_API_URL=http://127.0.0.1:3000/v1
BW_API_URL=http://10.0.2.2:3000/v1

# Production/release builds must set the real HTTPS backend URL and Google maps.
# BW_PRODUCTION_API_URL=https://api.example.com/v1
# UAT release builds must set BW_RELEASE_CHANNEL=uat and a separate HTTPS URL.
# BW_UAT_API_URL=https://uat-api.example.com/v1

# Provider secrets never belong in the mobile app. Razorpay's public key is
# returned by the backend together with each provider order.
